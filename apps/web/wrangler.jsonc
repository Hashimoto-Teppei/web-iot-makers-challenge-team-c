{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "team-c-web",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  // SPA なので、未知のパスは index.html を返す。これがないとリロードで 404 になる。
  // 配信するディレクトリは @cloudflare/vite-plugin がビルド出力から決めるため、ここには書かない。
  "assets": {
    "not_found_handling": "single-page-application"
  },
  // D1（SQLite）。database_id は秘密情報ではないのでコミットしてよい。
  // 秘密にするのは Cloudflare の API トークンのほう。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "team-c-db",
      // 仮の値。デプロイ担当が実際のデータベースを作って差し替える（Issue #19）。
      // ローカル開発（--local）とテストはこの値を使わないため、このままでも開発できる。
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
