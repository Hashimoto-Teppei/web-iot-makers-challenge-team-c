{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "team-c-web",
  // Durable Object のクラスと fetch ハンドラを並べるだけのファイル。
  // 実装は src/worker/index.ts にある（分けている理由は entry.ts の冒頭）。
  "main": "src/worker/entry.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  // SPA なので、未知のパスは index.html を返す。これがないとリロードで 404 になる。
  // 配信するディレクトリは @cloudflare/vite-plugin がビルド出力から決めるため、ここには書かない。
  "assets": {
    "not_found_handling": "single-page-application"
  },
  // D1（SQLite）。database_id は秘密情報ではないのでコミットしてよい。
  // 秘密にするのは Cloudflare の API トークンのほう。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "team-c-db",
      // Cloudflare 上の実際のデータベース。ローカル開発（--local）とテストはこの値を使わない。
      "database_id": "3fd1b5ad-7a47-48b8-a3fe-c71d365e4cd3",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  // 走行中の近傍を保つ Durable Object。**インスタンスは1個だけ**で、状態はメモリにしか
  // 置かない（docs/interfaces/mobile-api.md）。名前と locationHint は
  // src/worker/v2v/config.ts が持つ。
  "durable_objects": {
    "bindings": [
      {
        "name": "NEIGHBORS",
        "class_name": "NeighborsDO"
      }
    ]
  },
  // Durable Object のクラスは migration で宣言しないとデプロイできない。
  // ストレージは使わないが、新しいクラスは new_sqlite_classes で入れる
  // （new_classes は旧来の課金プラン向けで、無料プランでは作れない）。
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["NeighborsDO"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
